# Copy to .env (git-ignored). Twitch app: Confidential client, OAuth redirect URL = TWITCH_REDIRECT_URI exactly.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:3017/auth/callback
# login of the channel whose chat drives the overlay (resolved to broadcaster_id via GET /helix/users)
TWITCH_CHANNEL=
PORT=3017
